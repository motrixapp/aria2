# scripts/ci/deps.env — single source of truth for vendored dep versions and
# artifact digests. Consumed by makerelease-osx.mk (Make `include`),
# build-linux-deps.sh (shell `.`-source), Dockerfile.mingw and
# Dockerfile.android (COPY + `. /deps.env`).
#
# CONSTRAINT: values are LITERALS only — no $(...) / $VAR references — so GNU
# Make's recursive-assignment and POSIX shell's literal semantics agree.
# Names are UPPERCASE with no spaces around '=' (required for shell sourcing;
# also valid Make). Per-target URLs and configure flags stay local to each
# build file. Each <DEP>_SHA256 pins the exact artifact the lanes download;
# where lanes download different archive formats there is one digest per
# format. macOS-only deps keep their digests in makerelease-osx.mk.

ZLIB_VERSION=1.3.2
# zlib-$ZLIB_VERSION.tar.gz (GitHub release asset; identical to zlib.net copy)
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
EXPAT_VERSION=2.8.3
# expat GitHub release tag (couples to version)
EXPAT_TAG=R_2_8_3
# expat-$EXPAT_VERSION.tar.bz2 (the .tar.gz used by macOS hashes differently)
EXPAT_SHA256=b4cc2483927d5e90bf8c40b44a6b95b368b42a8a96e25883fce188b48a92b670
CARES_VERSION=1.34.8
# c-ares-$CARES_VERSION.tar.gz (matches upstream SLSA provenance)
CARES_SHA256=c222b6d681096f9444d2c4863d2c1174019e27cacca0a4a5c114d36dd7d7bf78
# full autoconf tag; used as sqlite-$SQLITE_VERSION
SQLITE_VERSION=autoconf-3530400
# sqlite download URL path segment (couples to version)
SQLITE_YEAR=2026
# sqlite-$SQLITE_VERSION.tar.gz (sqlite.org publishes SHA3-256; artifact
# cross-checked against the published size + SHA3-256 before pinning)
SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c
LIBSSH2_VERSION=1.11.1
# libssh2-$LIBSSH2_VERSION.tar.gz (linux + macOS lanes)
LIBSSH2_SHA256=d9ec76cbe34db98eec3539fe2c899d26b0c837cb3eb466a56b0f109cabf658f7
# libssh2-$LIBSSH2_VERSION.tar.bz2 (mingw + android lanes)
LIBSSH2_BZ2_SHA256=8ddbd698403a2c3a9987df48f2940c6f6a9bddce28d37eb201938dd7755646f0
GMP_VERSION=6.3.0
# gmp-$GMP_VERSION.tar.xz
GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
# Windows + Linux + Android + macOS (OpenSSL 3.5 LTS)
OPENSSL_VERSION=3.5.8
# openssl-$OPENSSL_VERSION.tar.gz (matches upstream .sha256 release asset)
OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2

# Windows ARM64 uses LLVM-MinGW/UCRT; GCC MinGW lanes remain unchanged.
# Official llvm-mingw-$LLVM_MINGW_VERSION-ucrt-ubuntu-22.04-{arch}.tar.xz
# release asset digests from mstorsjo/llvm-mingw.
LLVM_MINGW_VERSION=20261006
LLVM_MINGW_X86_64_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4
LLVM_MINGW_AARCH64_SHA256=e77c4acfa44184f6b0c52b814d724ad63b2ecebb3c3f6f842c0846e717cbd23c

# macOS-only source-pinned deps (mingw uses Debian apt for these — unchanged):
LIBGCRYPT_VERSION=1.12.3
LIBGPGERROR_VERSION=1.61
CPPUNIT_VERSION=1.15.1
