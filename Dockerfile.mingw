# Dockerfile to build aria2 Windows binary using ubuntu mingw-w64
# cross compiler chain.
#
# $ sudo docker build -t aria2-mingw - < Dockerfile.mingw
#
# After successful build, windows binary is located at
# /aria2/src/aria2c.exe.  You can copy the binary using following
# commands:
#
# $ sudo docker run --rm -it -v /path/to/dest:/out aria2-mingw cp /aria2/src/aria2c.exe /out

FROM ubuntu:22.04

MAINTAINER Tatsuhiro Tsujikawa

# Use x86_64-w64-mingw32 for x64 or aarch64-w64-mingw32 for ARM64.
ARG HOST=i686-w64-mingw32

# It would be better to use nearest ubuntu archive mirror for faster
# downloads.
# RUN sed -ie 's/archive\.ubuntu/jp.archive.ubuntu/g' /etc/apt/sources.list

RUN apt-get update && \
    DEBIAN_FRONTEND="noninteractive" \
    apt-get install -y --no-install-recommends \
        make binutils autoconf automake autotools-dev libtool \
        patch ca-certificates xz-utils \
        pkg-config git curl dpkg-dev gcc-mingw-w64 g++-mingw-w64 \
        autopoint libcppunit-dev libxml2-dev libgcrypt20-dev lzip \
        python3-docutils

COPY scripts/ci/deps.env /deps.env
COPY patches /patches
COPY scripts/ci/openssl-mingw-arm64.conf /openssl-mingw-arm64.conf

# LLVM-MinGW provides the Windows ARM64 UCRT toolchain missing from Ubuntu's
# GCC MinGW packages. Select the build-machine archive, not the target arch,
# so the same Dockerfile can run natively on Linux x64 and ARM64 hosts.
RUN if [ "$HOST" = aarch64-w64-mingw32 ]; then \
      . /deps.env && \
      case "$(uname -m)" in \
        x86_64) llvm_arch=x86_64; llvm_sha256=$LLVM_MINGW_X86_64_SHA256 ;; \
        aarch64) llvm_arch=aarch64; llvm_sha256=$LLVM_MINGW_AARCH64_SHA256 ;; \
        *) echo 'Unsupported LLVM-MinGW build machine' >&2; exit 1 ;; \
      esac && \
      curl -fL --retry 5 --retry-delay 3 --retry-all-errors \
        --connect-timeout 30 --speed-limit 1 --speed-time 30 \
        -o /llvm-mingw.tar.xz \
        "https://github.com/mstorsjo/llvm-mingw/releases/download/$LLVM_MINGW_VERSION/llvm-mingw-$LLVM_MINGW_VERSION-ucrt-ubuntu-22.04-$llvm_arch.tar.xz" && \
      echo "$llvm_sha256  /llvm-mingw.tar.xz" | sha256sum -c - && \
      mkdir /opt/llvm-mingw && \
      tar xf /llvm-mingw.tar.xz -C /opt/llvm-mingw --strip-components=1 && \
      rm /llvm-mingw.tar.xz; \
    fi
ENV PATH="/opt/llvm-mingw/bin:${PATH}"

# fetch(): -f fails on HTTP errors (so a 404 errors here instead of saving an
# error page that tar chokes on later); --retry + --speed-time abort/retry a
# stalled transfer; the trailing sha256sum -c fails the build on any digest
# mismatch (digests pinned in deps.env). gmp is taken from the GNU mirror
# because gmplib.org stalls (0 bytes) against CI/datacenter IPs.
RUN . /deps.env && \
    fetch() { curl -fL --retry 5 --retry-delay 3 --retry-all-errors --retry-connrefused \
                --connect-timeout 30 --speed-limit 1 --speed-time 30 -O "$1" && \
              echo "$2  ${1##*/}" | sha256sum -c -; } && \
    fetch https://ftp.gnu.org/gnu/gmp/gmp-$GMP_VERSION.tar.xz "$GMP_SHA256" && \
    fetch https://github.com/libexpat/libexpat/releases/download/$EXPAT_TAG/expat-$EXPAT_VERSION.tar.bz2 "$EXPAT_SHA256" && \
    fetch https://www.sqlite.org/$SQLITE_YEAR/sqlite-$SQLITE_VERSION.tar.gz "$SQLITE_SHA256" && \
    fetch https://github.com/madler/zlib/releases/download/v$ZLIB_VERSION/zlib-$ZLIB_VERSION.tar.gz "$ZLIB_SHA256" && \
    fetch https://github.com/c-ares/c-ares/releases/download/v$CARES_VERSION/c-ares-$CARES_VERSION.tar.gz "$CARES_SHA256" && \
    fetch https://github.com/openssl/openssl/releases/download/openssl-$OPENSSL_VERSION/openssl-$OPENSSL_VERSION.tar.gz "$OPENSSL_SHA256" && \
    fetch https://libssh2.org/download/libssh2-$LIBSSH2_VERSION.tar.bz2 "$LIBSSH2_BZ2_SHA256"

RUN . /deps.env && tar xf gmp-$GMP_VERSION.tar.xz && \
    cd gmp-$GMP_VERSION && \
    case "$HOST" in \
      aarch64-w64-mingw32) gmp_arch_flags=--disable-assembly; gmp_cflags='-O2 -g0' ;; \
      *) gmp_arch_flags=--enable-fat; gmp_cflags='-mtune=generic -O2 -g0' ;; \
    esac && \
    ./configure \
        --disable-shared \
        --enable-static \
        --prefix=/usr/local/$HOST \
        --host=$HOST \
        --disable-cxx \
        $gmp_arch_flags \
        CFLAGS="$gmp_cflags" && \
    make -j$(nproc) install

RUN . /deps.env && tar xf expat-$EXPAT_VERSION.tar.bz2 && \
    cd expat-$EXPAT_VERSION && \
    ./configure \
        --disable-shared \
        --enable-static \
        --prefix=/usr/local/$HOST \
        --host=$HOST \
        --build=`dpkg-architecture -qDEB_BUILD_GNU_TYPE` && \
    make -j$(nproc) install

RUN . /deps.env && tar xf sqlite-$SQLITE_VERSION.tar.gz && \
    cd sqlite-$SQLITE_VERSION && \
    ./configure \
        --disable-shared \
        --enable-static \
        --prefix=/usr/local/$HOST \
        --host=$HOST \
        --build=`dpkg-architecture -qDEB_BUILD_GNU_TYPE` && \
    make -j$(nproc) install

RUN . /deps.env && tar xf zlib-$ZLIB_VERSION.tar.gz && \
    cd zlib-$ZLIB_VERSION && \
    CC=$HOST-gcc \
    AR=$HOST-ar \
    LD=$HOST-ld \
    RANLIB=$HOST-ranlib \
    STRIP=$HOST-strip \
    ./configure \
        --prefix=/usr/local/$HOST \
        --libdir=/usr/local/$HOST/lib \
        --includedir=/usr/local/$HOST/include \
        --static && \
    make -j$(nproc) install

# Keep the provider modules built into the static libraries: aria2 loads the
# legacy provider for BitTorrent MSE, and a standalone aria2c.exe cannot dlopen
# a legacy provider DLL. Do not build the unused command-line applications or
# let the portable aria2c.exe auto-load a machine-wide openssl.cnf. The latter
# can otherwise change provider activation and default EVP properties before
# aria2 initializes its statically linked providers. OpenSSL 3.2+ also builds
# in its Windows store loader; aria2 explicitly attaches that loader to the
# native ROOT store, so the packaged application does not need SSL_CERT_FILE or
# a bundled CA file.
RUN . /deps.env && tar xf openssl-$OPENSSL_VERSION.tar.gz && \
    cd openssl-$OPENSSL_VERSION && \
    case "$HOST" in \
      x86_64-w64-mingw32) openssl_target=mingw64 ;; \
      i686-w64-mingw32) openssl_target=mingw ;; \
      aarch64-w64-mingw32) openssl_target=mingw-arm64; \
        cp /openssl-mingw-arm64.conf Configurations/99-mingw-arm64.conf ;; \
      *) echo "Unsupported MinGW host: $HOST" >&2; exit 1 ;; \
    esac && \
    ./Configure \
        no-shared \
        no-module \
        no-tests \
        no-apps \
        no-autoload-config \
        --cross-compile-prefix=$HOST- \
        --prefix=/usr/local/$HOST \
        --libdir=lib \
        "$openssl_target" && \
    make -j$(nproc) && \
    make install_sw

RUN . /deps.env && tar xf c-ares-$CARES_VERSION.tar.gz && \
    cd c-ares-$CARES_VERSION && \
    ./configure \
        --disable-shared \
        --enable-static \
        --prefix=/usr/local/$HOST \
        --host=$HOST \
        --build=`dpkg-architecture -qDEB_BUILD_GNU_TYPE` \
        LIBS="-lws2_32" && \
    make -j$(nproc) install

RUN . /deps.env && tar xf libssh2-$LIBSSH2_VERSION.tar.bz2 && \
    cd libssh2-$LIBSSH2_VERSION && \
    for p in /patches/libssh2-$LIBSSH2_VERSION-*.patch; do patch -p1 < "$p" || exit 1; done && \
    ./configure \
        --disable-shared \
        --enable-static \
        --prefix=/usr/local/$HOST \
        --host=$HOST \
        --build=`dpkg-architecture -qDEB_BUILD_GNU_TYPE` \
        --disable-examples-build \
        --with-crypto=openssl \
        --with-libssl-prefix=/usr/local/$HOST \
        CPPFLAGS="-I/usr/local/$HOST/include" \
        LDFLAGS="-L/usr/local/$HOST/lib" \
        PKG_CONFIG_LIBDIR="/usr/local/$HOST/lib/pkgconfig" \
        LIBS="-lws2_32" && \
    make -j$(nproc) install

COPY . /aria2
WORKDIR /aria2
RUN if [ "$HOST" = aarch64-w64-mingw32 ]; then \
      patch /usr/share/aclocal/libtool.m4 /patches/libtool-clang-rt.patch; \
    fi && autoreconf -fi

# Release builds use OpenSSL. Declare this argument next to the only layer it
# affects so WinTLS compatibility builds can reuse all dependency layers.
ARG TLS_BACKEND=openssl
RUN TLS_BACKEND="$TLS_BACKEND" ./mingw-config && \
    case "$TLS_BACKEND" in \
      openssl) grep -q '^#define HAVE_OPENSSL 1' config.h && \
               grep -q '^# *define OPENSSL_NO_AUTOLOAD_CONFIG' \
                 /usr/local/$HOST/include/openssl/configuration.h && \
               test ! -e /usr/local/$HOST/bin/openssl.exe && \
               ! grep -q '^#define HAVE_WINTLS 1' config.h ;; \
      wintls)  grep -q '^#define HAVE_WINTLS 1' config.h && \
               ! grep -q '^#define HAVE_OPENSSL 1' config.h ;; \
      *) echo "Unsupported TLS_BACKEND: $TLS_BACKEND" >&2; exit 1 ;; \
    esac && \
    make -j$(nproc) && \
    $HOST-strip src/aria2c.exe && \
    $HOST-objdump -p src/aria2c.exe > /aria2/windows-pe.txt && \
    ! grep -Eiq \
        'DLL Name: .*(libssl|libcrypto|libc\+\+|libunwind|libwinpthread|libstdc\+\+|libgcc)[^ ]*\.dll' \
        /aria2/windows-pe.txt
